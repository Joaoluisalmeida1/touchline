# ---------- Supabase (Project Settings → API / Database) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_...) — safe for the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — server only. Currently unused by the app (DB access goes through SUPABASE_DB_URL).
SUPABASE_SECRET_KEY=
# Postgres connection string used by the server (RLS is applied via role impersonation per request).
# Vercel/serverless: use the Supavisor *transaction* pooler (port 6543). CLI imports: session pooler (5432) or direct.
SUPABASE_DB_URL=postgresql://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ---------- PlayerElo (server/CLI only, never NEXT_PUBLIC) ----------
PLAYERELO_API_KEY=
# PLAYERELO_BASE_URL=https://data-api.playerelo.football
# Free plan: 10 req/min documented → 9 for headroom
PLAYERELO_RATE_PER_MINUTE=9
# Only set to true after confirming your licence allows storing raw responses (docs/data-licensing.md)
PLAYERELO_RETAIN_RAW=false

# ---------- App ----------
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Touchline
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
# Optional: Discord/Slack incoming webhook for server error alerts (src/instrumentation.ts)
# ALERT_WEBHOOK_URL=
# supabase (default) | dev  — dev = LOCAL-ONLY auth adapter for tests without Supabase; refused on Vercel/production
AUTH_MODE=supabase
# DEV_AUTH_SECRET=at-least-32-random-characters-for-local-dev
# PG_POOL_MAX=5

# ---------- Web push (optional) ----------
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
